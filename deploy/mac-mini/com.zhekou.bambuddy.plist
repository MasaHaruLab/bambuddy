<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zhekou.bambuddy</string>
    <!-- Starts the server through `ssh localhost` (see bambuddy-run.sh):
         launchd's own children are denied Local Network by macOS privacy,
         sshd's children are not. PATH/ffmpeg is handled inside the wrapper. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ambrosiazheng/bambuddy/bin/bambuddy-run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/ambrosiazheng/bambuddy</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ambrosiazheng/bambuddy/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ambrosiazheng/bambuddy/logs/launchd.log</string>
</dict>
</plist>
